"""Tests for the calculator. Run from the project folder: python -m unittest discover -v"""

import io
import unittest
from contextlib import redirect_stderr, redirect_stdout

import calculator
from calculator import CalculatorError, calculate, evaluate, format_result, parse_number


class CalculateTests(unittest.TestCase):
    def test_basic_operations(self):
        self.assertEqual(calculate(2, "+", 3), 5)
        self.assertEqual(calculate(2, "-", 3), -1)
        self.assertEqual(calculate(4, "*", 2.5), 10)
        self.assertEqual(calculate(4, "x", 2.5), 10)
        self.assertEqual(calculate(7, "/", 2), 3.5)

    def test_divide_by_zero_is_an_error(self):
        with self.assertRaisesRegex(CalculatorError, "divide by zero"):
            calculate(1, "/", 0)

    def test_unknown_operator_is_an_error(self):
        with self.assertRaisesRegex(CalculatorError, "Unknown operator"):
            calculate(1, "%", 2)

    def test_overflow_is_an_error(self):
        with self.assertRaisesRegex(CalculatorError, "too large"):
            calculate(1e308, "*", 10)


class ParseAndFormatTests(unittest.TestCase):
    def test_parses_numbers(self):
        self.assertEqual(parse_number("42"), 42)
        self.assertEqual(parse_number("-3.5"), -3.5)

    def test_rejects_text_and_infinity(self):
        for text in ["abc", "", "inf", "nan"]:
            with self.subTest(text=text), self.assertRaises(CalculatorError):
                parse_number(text)

    def test_formats_results(self):
        self.assertEqual(format_result(42.0), "42")
        self.assertEqual(format_result(3.5), "3.5")
        self.assertEqual(format_result(0.1 + 0.2), "0.3")


class EvaluateTests(unittest.TestCase):
    def test_expressions(self):
        self.assertEqual(evaluate("12 + 30"), "42")
        self.assertEqual(evaluate("-5 * 3"), "-15")
        self.assertEqual(evaluate("1 / 3"), "0.3333333333")

    def test_wrong_shape_is_explained(self):
        for text in ["12", "1 +", "1 + 2 + 3"]:
            with self.subTest(text=text), self.assertRaisesRegex(CalculatorError, "number operator number"):
                evaluate(text)


class CommandLineTests(unittest.TestCase):
    def run_main(self, args):
        out, err = io.StringIO(), io.StringIO()
        with redirect_stdout(out), redirect_stderr(err):
            code = calculator.main(args)
        return code, out.getvalue(), err.getvalue()

    def test_prints_result(self):
        self.assertEqual(self.run_main(["6", "x", "7"]), (0, "42\n", ""))

    def test_error_goes_to_stderr_with_exit_code_1(self):
        code, out, err = self.run_main(["1", "/", "0"])
        self.assertEqual((code, out), (1, ""))
        self.assertIn("divide by zero", err)

    def test_help(self):
        code, out, _ = self.run_main(["--help"])
        self.assertEqual(code, 0)
        self.assertIn("Usage", out)

    def test_interactive_session(self):
        lines = iter(["3 * 4", "oops", "", "quit"])
        shown = []
        calculator.interactive(read=lambda prompt: next(lines), write=shown.append)
        self.assertEqual(shown[1:], ["12", "Error: " + calculator.USAGE])

    def test_interactive_stops_at_end_of_input(self):
        def read(prompt):
            raise EOFError

        shown = []
        calculator.interactive(read=read, write=shown.append)
        self.assertEqual(len(shown), 1)


if __name__ == "__main__":
    unittest.main()
