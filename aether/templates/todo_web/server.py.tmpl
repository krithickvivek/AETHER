"""Run the to-do web app on this computer.

    python server.py

Then open http://127.0.0.1:8000 in a browser. Press Ctrl+C to stop.
Data is saved in todo.db next to this file.
"""

from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path

from todo_app.db import connect
from todo_app.web import TodoApp

HOST, PORT = "127.0.0.1", 8000   # this computer only
MAX_BODY_BYTES = 100_000
DATABASE = Path(__file__).with_name("todo.db")


def make_handler(app: TodoApp) -> type[BaseHTTPRequestHandler]:
    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            self.respond("GET")

        def do_POST(self):
            self.respond("POST")

        def respond(self, method: str) -> None:
            try:
                length = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                self.send_error(400, "Invalid Content-Length")
                return
            if length < 0 or length > MAX_BODY_BYTES:
                self.send_error(413, "Request too large")
                return
            body = self.rfile.read(length) if length else b""
            response = app.handle(method, self.path.split("?", 1)[0], body, self.headers.get("Cookie", ""))
            data = response.body.encode("utf-8")
            self.send_response(response.status)
            self.send_header("Content-Type", response.content_type)
            self.send_header("Content-Length", str(len(data)))
            for name, value in response.headers:
                self.send_header(name, value)
            self.end_headers()
            self.wfile.write(data)

    return Handler


def main() -> None:
    app = TodoApp(connect(str(DATABASE)))
    server = HTTPServer((HOST, PORT), make_handler(app))
    print(f"To-do app running at http://{HOST}:{PORT} (press Ctrl+C to stop)")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
