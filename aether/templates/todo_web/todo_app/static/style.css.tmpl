/* Styles for the to-do web app. */
* { box-sizing: border-box; }
body { margin: 0; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; color: #18181b; background: #fafafa; }
header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;
  padding: 0.9rem 1.25rem; background: #fff; border-bottom: 1px solid #e4e4e7; }
header nav { display: flex; align-items: center; gap: 0.9rem; font-size: 0.9rem; }
header form { margin: 0; }
.brand { font-weight: 700; color: #6d28d9; text-decoration: none; }
a { color: #6d28d9; }
main { max-width: 640px; margin: 2rem auto; padding: 0 1rem; }
h1 { font-size: 1.5rem; margin: 0 0 1rem; }
.card { display: grid; gap: 0.8rem; background: #fff; border: 1px solid #e4e4e7; border-radius: 10px; padding: 1.25rem; }
label { display: grid; gap: 0.3rem; font-size: 0.9rem; }
input { font: inherit; padding: 0.55rem 0.7rem; border: 1px solid #d4d4d8; border-radius: 8px; width: 100%; }
button { font: inherit; padding: 0.55rem 1rem; border: 0; border-radius: 8px; background: #6d28d9; color: #fff; cursor: pointer; }
button.link { background: none; color: #6d28d9; padding: 0.2rem 0.4rem; }
button.danger { color: #dc2626; }
.add { display: flex; gap: 0.5rem; margin-bottom: 1rem; }
.tasks { list-style: none; padding: 0; margin: 0; background: #fff; border: 1px solid #e4e4e7; border-radius: 10px; }
.tasks li { display: flex; align-items: center; gap: 0.5rem; padding: 0.6rem 0.9rem; border-bottom: 1px solid #f4f4f5; }
.tasks li:last-child { border-bottom: 0; }
.tasks li form { margin: 0; }
.tasks .title { flex: 1; overflow-wrap: anywhere; }
.tasks li.done .title { text-decoration: line-through; color: #a1a1aa; }
.error { color: #b91c1c; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 0.6rem 0.8rem; }
.empty { color: #71717a; }
@media (max-width: 480px) { .add { flex-direction: column; } }
